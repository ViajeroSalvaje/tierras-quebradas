<div style="height:100%;width:100%;display:flex;flex-direction:column;">
  <section class="item-body" style="flex:1;overflow-y:auto;padding:8px 12px;display:flex;flex-direction:column;gap:10px;">

    <h1><input type="text" name="name" value="{{item.name}}" placeholder="{{localize "TQ.Placeholders.Nombre"}}" /></h1>

    <div class="item-grid" style="margin-top:4px;">
      <div class="tq-field-group">
        <label>{{localize "TQ.Rasgos.CostePP"}}</label>
        <input type="number" name="system.coste" value="{{system.coste}}" />
      </div>
      <div class="tq-field-group">
        <label>{{localize "TQ.General.Tipo"}}</label>
        <select name="system.tipo">
          <option value="rasgoSobrenatural" {{selected system.tipo "rasgoSobrenatural"}}>Poder / Inmunidad</option>
          <option value="rasgoSocial"       {{selected system.tipo "rasgoSocial"}}>Social</option>
          <option value="habilidadEspecial" {{selected system.tipo "habilidadEspecial"}}>Habilidad especial</option>
          <option value="personalidad"      {{selected system.tipo "personalidad"}}>Personalidad</option>
        </select>
      </div>
    </div>

    <div class="tq-field-group full-width">
      <label>{{localize "TQ.General.Efecto"}}</label>
      <textarea name="system.efecto" rows="3">{{system.efecto}}</textarea>
    </div>

    <div class="tq-field-group full-width">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;">
        <label>{{localize "TQ.General.ModificadoresHabilidades"}}</label>
        <a class="rasgo-hab-add" style="font-size:11px;color:var(--tq-teal);cursor:pointer;"><i class="fas fa-plus"></i> {{localize "TQ.Botones.Anadir"}}</a>
      </div>
      <table style="width:100%;font-size:12px;">
        <thead><tr><th style="text-align:left;">{{localize "TQ.General.Habilidad"}}</th><th style="width:60px;text-align:center;">{{localize "TQ.General.Bonus"}}</th><th style="width:30px;"></th></tr></thead>
        <tbody>
          {{#each habilidades as |h|}}
          <tr>
            <td>
              <select class="rasgo-hab-clave" data-index="{{h.index}}" data-field="clave" style="width:100%;">
                <option value="">— Seleccionar —</option>
                {{#each h.opciones as |op|}}<option value="{{op.clave}}" {{#if op.selected}}selected{{/if}}>{{op.label}}</option>{{/each}}
              </select>
            </td>
            <td><input type="number" class="rasgo-hab-bonus" data-index="{{h.index}}" data-field="bonus" value="{{h.bonus}}" style="width:55px;text-align:center;" /></td>
            <td><a class="rasgo-hab-del" data-index="{{h.index}}" style="color:var(--tq-red-dmg);cursor:pointer;"><i class="fas fa-trash"></i></a></td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="tq-field-group full-width">
      <label>{{localize "TQ.General.Descripcion"}}</label>
      <textarea name="system.descripcion" rows="4">{{system.descripcion}}</textarea>
    </div>

  </section>
</div>
