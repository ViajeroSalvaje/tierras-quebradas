<div class="{{cssClass}} flexcol" autocomplete="off" style="height:100%;width:100%;">
  <section class="item-body">
    <div class="tq-item-header-fila">
      <img class="item-img" src="{{item.img}}" title="{{item.name}}" />
      <h1><input type="text" name="name" value="{{item.name}}" placeholder="{{localize "TQ.Placeholders.Nombre"}}" /></h1>
    </div>
    <div class="item-grid">
      <div class="tq-field-group">
        <label>{{localize "TQ.Combate.carga"}}</label>
        <input type="number" name="system.carga" value="{{system.carga}}" step="0.1" min="0" />
      </div>
      <div class="tq-field-group">
        <label>{{localize "TQ.General.PrecioMB"}}</label>
        <input type="number" name="system.precio" value="{{system.precio}}" min="0" />
      </div>
      <div class="tq-field-group full-width">
        <label>{{localize "TQ.Objeto.Categoria"}}</label>
        <input type="text" name="system.categoria" value="{{system.categoria}}" placeholder="Aventura, Herramientas, Lujo…" />
      </div>
    </div>
    <div class="tq-field-group full-width">
      <label>{{localize "TQ.General.Descripcion"}}</label>
      <textarea name="system.descripcion" rows="5">{{system.descripcion}}</textarea>
    </div>
    {{#if system.esDemoniaco}}
    <hr />
    <div class="tq-demoniaco-section">
      <p class="tq-demoniaco-titulo">Objeto Demoníaco — {{system.demonioNombre}} ({{system.vm}} VM)</p>
      <div class="item-grid">
        {{#if system.bonoDanho}}<div class="tq-field-group"><label>Bono al daño</label><input type="number" name="system.bonoDanho" value="{{system.bonoDanho}}" /></div>{{/if}}
        {{#if system.bonoHabilidad}}<div class="tq-field-group"><label>Bono habilidad</label><input type="number" name="system.bonoHabilidad" value="{{system.bonoHabilidad}}" /></div>{{/if}}
        {{#if system.bonoHabilidad}}<div class="tq-field-group"><label>Habilidad</label><input type="text" name="system.bonoHabilidadClave" value="{{system.bonoHabilidadClave}}" /></div>{{/if}}
        {{#if system.demonioProteccion}}<div class="tq-field-group"><label>Protección</label><input type="number" name="system.demonioProteccion" value="{{system.demonioProteccion}}" /></div>{{/if}}
      </div>
      <div class="tq-demoniaco-flags">
        {{#if system.danhoMagico}}<span class="tq-demoniaco-tag">Daño mágico</span>{{/if}}
        {{#if system.danhoEspiritual}}<span class="tq-demoniaco-tag">Daño espiritual</span>{{/if}}
        {{#if system.vampiro}}<span class="tq-demoniaco-tag">Vampiro</span>{{/if}}
        {{#if system.irrompible}}<span class="tq-demoniaco-tag">Irrompible</span>{{/if}}
        {{#if system.salvaguardaFuego}}<span class="tq-demoniaco-tag">Salvaguarda fuego</span>{{/if}}
        {{#if system.salvaguardaArmas}}<span class="tq-demoniaco-tag">Salvaguarda armas</span>{{/if}}
        {{#if system.pmPropios}}<span class="tq-demoniaco-tag">PM propios</span>{{/if}}
      </div>
      {{#if system.conjuros.length}}
      <p class="tq-demoniaco-sub">Conjuros: {{#each system.conjuros}}{{nombre}} (Dif {{dificultad}}){{#unless @last}}, {{/unless}}{{/each}}</p>
      {{/if}}
    </div>
    {{/if}}
  </section>
</div>
