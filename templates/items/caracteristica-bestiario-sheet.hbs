<div class="{{cssClass}} flexcol" autocomplete="off" style="height:100%;width:100%;">

  <div class="tq-item-header-fila">
    <img class="profile-img item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div style="flex:1;display:flex;flex-direction:column;gap:6px;">
      <h1><input type="text" name="name" value="{{item.name}}" placeholder="{{localize "TQ.Placeholders.Nombre"}}" /></h1>
      <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">

        <div class="tq-field-group" style="flex-direction:row;align-items:center;gap:6px;">
          <label style="white-space:nowrap;font-size:11px;">Tipo</label>
          <select name="system.tipo" style="font-size:11px;">
            <option value="rasgo"     {{selected system.tipo "rasgo"}}>Rasgo / Poder</option>
            <option value="debilidad" {{selected system.tipo "debilidad"}}>Debilidad</option>
          </select>
        </div>

        <div class="tq-field-group" style="flex-direction:row;align-items:center;gap:6px;">
          <label style="white-space:nowrap;">VM</label>
          {{#unless system.vmVariable}}
          <input type="number" name="system.vm" value="{{system.vm}}" min="0" style="width:55px;" />
          {{else}}
          <span style="font-style:italic;font-size:12px;">Variable</span>
          {{/unless}}
          <label style="display:flex;align-items:center;gap:4px;margin-left:4px;font-size:11px;white-space:nowrap;cursor:pointer;">
            <input type="checkbox" name="system.vmVariable" {{#if system.vmVariable}}checked{{/if}} style="display:none;" />
            <span class="tq-circulo {{#if system.vmVariable}}marcado{{/if}}" data-toggle="vmVariable"></span>
            Variable
          </label>
        </div>

        <div class="tq-field-group" style="flex-direction:row;align-items:center;gap:6px;">
          <label style="white-space:nowrap;">Daño</label>
          <input type="number" name="system.dano" value="{{system.dano}}" min="0" style="width:55px;" />
        </div>

        <div class="tq-field-group" style="flex-direction:row;align-items:center;gap:6px;">
          <label style="display:flex;align-items:center;gap:4px;font-size:11px;white-space:nowrap;cursor:pointer;">
            <input type="checkbox" name="system.creaArma" {{#if system.creaArma}}checked{{/if}} style="display:none;" />
            <span class="tq-circulo {{#if system.creaArma}}marcado{{/if}}" data-toggle="creaArma"></span>
            Crea arma
          </label>
        </div>

      </div>

      {{#if system.creaArma}}
      <div class="tq-field-group" style="flex-direction:row;align-items:center;gap:6px;margin-top:2px;">
        <label style="white-space:nowrap;font-size:11px;">Tipo rociada</label>
        <select name="system.tipoArma" style="font-size:11px;">
          <option value="" {{selected system.tipoArma ""}}>— Ninguno —</option>
          <option value="Fuego"              {{selected system.tipoArma "Fuego"}}>Fuego</option>
          <option value="Ácido"              {{selected system.tipoArma "Ácido"}}>Ácido</option>
          <option value="Escarcha"           {{selected system.tipoArma "Escarcha"}}>Escarcha</option>
          <option value="Electricidad"       {{selected system.tipoArma "Electricidad"}}>Electricidad</option>
          <option value="Energía"            {{selected system.tipoArma "Energía"}}>Energía</option>
          <option value="Espuma deformante"  {{selected system.tipoArma "Espuma deformante"}}>Espuma deformante</option>
          <option value="Mancha"             {{selected system.tipoArma "Mancha"}}>Mancha</option>
        </select>
      </div>
      {{/if}}
    </div>
  </div>

  <section class="item-body" style="padding:6px;">
    <div class="tq-field-group full-width">
      <label>{{localize "TQ.General.Descripcion"}}</label>
      <textarea name="system.descripcion" rows="10" class="tq-notas">{{system.descripcion}}</textarea>
    </div>
  </section>

</div>
