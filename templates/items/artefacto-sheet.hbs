<div class="{{cssClass}} flexcol" autocomplete="off" style="height:100%;width:100%;">
  <div class="tq-item-header-fila">
    <img class="profile-img item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <h1><input type="text" name="name" value="{{item.name}}" /></h1>
  </div>

  <nav class="sheet-tabs">
    <a class="item active" data-tab="datos">{{localize "TQ.Tabs.Estadisticas"}}</a>
    <a class="item" data-tab="poderes">{{localize "TQ.Secciones.Poderes"}}</a>
    <a class="item" data-tab="notas">{{localize "TQ.Tabs.notas"}}</a>
  </nav>

  <div class="item-body" style="overflow-y:auto;flex:1;">

    <div class="tab active" data-tab="datos">
      <div style="padding:8px 8px 4px;font-size:18px;">
        <div style="font-size:10px;color:var(--tq-text-dim);margin-bottom:2px;">Objeto (receptáculo)</div>
        <span>{{system.tipoObjeto}}</span>
      </div>
      <div style="margin:4px 8px;height:1px;background:rgba(0,0,0,0.2);"></div>
      <div style="display:flex;align-items:center;padding:6px 8px;gap:0;">
        <div class="caract-item" style="padding-right:14px;">
          <span class="caract-etiqueta">Espíritu</span>
          <div class="tq-caract-sec-circulo"><span>{{system.espiritu}}</span></div>
        </div>
        <div style="width:1px;background:rgba(0,0,0,0.2);align-self:stretch;margin:0 14px;"></div>
        <div style="display:flex;gap:12px;flex:1;justify-content:space-around;">
          <div class="caract-item">
            <span class="caract-etiqueta">VM Total</span>
            <div class="tq-caract-sec-circulo"><span>{{system.valorMagico}}</span></div>
          </div>
          <div class="caract-item">
            <span class="caract-etiqueta">VM Gastado</span>
            <div class="tq-caract-sec-circulo"><span>{{system.vmGastado}}</span></div>
          </div>
          <div class="caract-item">
            <span class="caract-etiqueta">VM Restante</span>
            <div class="tq-caract-sec-circulo"><span class="{{#if (tq-lt vmRestante 0)}}tq-rojo{{/if}}">{{vmRestante}}</span></div>
          </div>
        </div>
      </div>
      <div style="margin:4px 8px;height:1px;background:rgba(0,0,0,0.2);"></div>
      <div style="display:flex;align-items:center;gap:8px;padding:2px 8px 6px;">
        <span style="font-size:10px;color:var(--tq-text-dim);white-space:nowrap;">PM (máx. {{pmMax}})</span>
        <div class="tq-fortuna-fila" style="flex:1;">
          <button type="button" class="pm-menos">−</button>
          <div class="fortuna-pips" style="flex-wrap:wrap;">
            {{#tq-rango 1 pmMax}}
            <span class="fortuna-pip {{#if (tq-gt (tq-add ../system.pm 1) this)}}lleno{{/if}}" style="font-size:24px;">●</span>
            {{/tq-rango}}
          </div>
          <button type="button" class="pm-mas">+</button>
        </div>
      </div>
      {{#if objetoBase}}
      <div style="margin:4px 8px;height:1px;background:rgba(0,0,0,0.2);"></div>
      <div style="padding:4px 8px 2px;">
        <div style="font-size:10px;color:var(--tq-text-dim);margin-bottom:4px;">Objeto base</div>
        {{#if (tq-eq objetoBase.tipoItem "arma")}}
        <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:13px;">
          {{#if objetoBase.danoArma}}<span><span style="color:var(--tq-text-dim);font-size:11px;">Daño</span> {{objetoBase.danoArma}}{{#if objetoBase.bonoDano}} {{#if (tq-gt objetoBase.bonoDano 0)}}+{{/if}}{{objetoBase.bonoDano}}{{/if}}</span>{{/if}}
          {{#if objetoBase.manos}}<span><span style="color:var(--tq-text-dim);font-size:11px;">Manos</span> {{objetoBase.manos}}</span>{{/if}}
          {{#if objetoBase.alcance}}<span><span style="color:var(--tq-text-dim);font-size:11px;">Alcance</span> {{objetoBase.alcance}}</span>{{/if}}
          {{#if objetoBase.habilidad}}<span><span style="color:var(--tq-text-dim);font-size:11px;">Hab.</span> {{localize (concat "TQ.Habilidades." objetoBase.habilidad)}}</span>{{/if}}
          {{#if objetoBase.tieneProteccion}}<span><span style="color:var(--tq-text-dim);font-size:11px;">Protección</span> {{objetoBase.proteccionValor}}</span>{{/if}}
        </div>
        {{else}}
        <div style="display:flex;gap:14px;flex-wrap:wrap;font-size:13px;">
          {{#if objetoBase.proteccion}}<span><span style="color:var(--tq-text-dim);font-size:11px;">Protección</span> {{objetoBase.proteccion}}</span>{{/if}}
          {{#if objetoBase.tipo}}<span><span style="color:var(--tq-text-dim);font-size:11px;">Tipo</span> {{objetoBase.tipo}}</span>{{/if}}
          {{#if objetoBase.zona}}<span><span style="color:var(--tq-text-dim);font-size:11px;">Zona</span> {{objetoBase.zona}}</span>{{/if}}
          {{#if objetoBase.carga}}<span><span style="color:var(--tq-text-dim);font-size:11px;">Carga</span> {{objetoBase.carga}}</span>{{/if}}
        </div>
        {{/if}}
      </div>
      {{/if}}
      <div style="margin:4px 8px;height:1px;background:rgba(0,0,0,0.2);"></div>
      <div style="display:flex;gap:12px;padding:4px 8px;flex-wrap:wrap;align-items:flex-start;font-size:17px;">
        <div style="flex:2;min-width:80px;">
          <div style="font-size:10px;color:var(--tq-text-dim);margin-bottom:2px;">Teúrgo</div>
          <span>{{system.teaurgo}}</span>
        </div>
        <div style="flex:1;min-width:60px;">
          <div style="font-size:10px;color:var(--tq-text-dim);margin-bottom:2px;">Coste</div>
          <span>{{system.coste}} mb</span>
        </div>
        {{#if system.tiempoConstruccion}}
        <div style="flex:1;min-width:60px;">
          <div style="font-size:10px;color:var(--tq-text-dim);margin-bottom:2px;">Tiempo de construcción</div>
          <span>{{system.tiempoConstruccion}}</span>
        </div>
        {{/if}}
      </div>
    </div>

    <div class="tab" data-tab="poderes">
      <div class="tq-section-box" style="margin:6px;">
        <div class="tq-section-header">
          <span>Hechizos</span>
          <span class="pnj-item-detalle">VM gastado: {{system.vmGastado}} / {{system.valorMagico}}</span>
        </div>
        <div class="tq-section-content">
          <div class="pnj-items-lista">
            {{#each poderesHechizos as |p|}}
            <div class="pnj-item-fila">
              <span class="pnj-item-nombre{{#if p.abrible}} tq-abrir-poder{{/if}}" data-idx="{{p._idx}}" style="{{#if p.abrible}}cursor:pointer;{{/if}}">{{p.nombre}}</span>
              <span class="pnj-item-detalle">{{p.vm}} VM{{#if p.pmCoste}} · {{p.pmCoste}} PM{{/if}}</span>
              <em class="tq-badge-auto" title="Activación automática en Fase 1, sin tirada">Auto · F1</em>
              <a class="poder-activar" data-idx="{{p._idx}}" title="Activar poder"><i class="fas fa-play"></i></a>
              <a class="poder-borrar" data-idx="{{p._idx}}" title="{{localize "TQ.Tooltips.Eliminar"}}"><i class="fas fa-trash"></i></a>
            </div>
            {{/each}}
          </div>
          <div class="hechizos-dropzone tq-dropzone"><i class="fas fa-magic"></i> Arrastra hechizos aquí</div>
        </div>
      </div>
      <div class="tq-section-box" style="margin:6px;">
        <div class="tq-section-header"><span>Rasgos</span></div>
        <div class="tq-section-content">
          <div class="pnj-items-lista">
            {{#each poderesRasgos as |p|}}
            <div class="pnj-item-fila">
              <span class="pnj-item-nombre{{#if p.abrible}} tq-abrir-poder{{/if}}" data-idx="{{p._idx}}" style="{{#if p.abrible}}cursor:pointer;{{/if}}">{{p.nombre}}</span>
              <span class="pnj-item-detalle">{{p.vm}} VM</span>
              <em class="tq-badge-auto" title="Activación automática en Fase 1, sin tirada">Auto · F1</em>
              <a class="poder-activar" data-idx="{{p._idx}}" title="Activar poder"><i class="fas fa-play"></i></a>
              <a class="poder-borrar" data-idx="{{p._idx}}" title="{{localize "TQ.Tooltips.Eliminar"}}"><i class="fas fa-trash"></i></a>
            </div>
            {{/each}}
          </div>
          <div class="rasgos-dropzone tq-dropzone"><i class="fas fa-paw"></i> Arrastra rasgos de bestiario aquí</div>
        </div>
      </div>
      {{#if habsSostenidas.length}}
      <div class="tq-section-box" style="margin:6px;">
        <div class="tq-section-header"><span>Habilidades sostenidas</span></div>
        <div class="tq-section-content">
          <div class="pnj-items-lista">
            {{#each habsSostenidas as |h|}}
            <div class="pnj-item-fila">
              <span class="pnj-item-nombre{{#if h.abrible}} tq-abrir-habilidad{{/if}}" data-idx="{{h._idx}}" style="{{#if h.abrible}}cursor:pointer;{{/if}}">{{h.nombre}}</span>
              <a class="habilidad-borrar" data-idx="{{h._idx}}" title="{{localize "TQ.Tooltips.Eliminar"}}"><i class="fas fa-trash"></i></a>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
      {{/if}}
      {{#if system.sosten}}
      <div class="tq-section-box" style="margin:6px;">
        <div class="tq-section-header"><span>Sostén de habilidades</span></div>
        <div class="tq-section-content" style="padding:8px;">
          <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
            <span style="flex:1;">
              <strong>{{system.sosten}}</strong>
              {{#if system.tipoObjeto}}<span class="pnj-item-detalle"> · vía {{system.tipoObjeto}}</span>{{/if}}
            </span>
            <span class="pnj-item-detalle">PM disponibles: {{system.pm}}</span>
            <button type="button" class="usar-sosten" style="padding:2px 10px;font-size:13px;">Usar sostén</button>
          </div>
          <p style="font-size:11px;color:var(--tq-text-dim);margin:6px 0 0;">1 PM = +1 · máx. +5 · declarar antes de tirar · requiere portador alineado con la Ley</p>
        </div>
      </div>
      {{/if}}
    </div>

    <div class="tab" data-tab="notas">
      <div style="padding:6px;">
        <div class="tq-field-group">
          <label>{{localize "TQ.General.Descripcion"}}</label>
          <textarea name="system.descripcion" rows="4" class="tq-notas">{{system.descripcion}}</textarea>
        </div>
        <div class="tq-field-group" style="margin-top:8px;">
          <label>{{localize "TQ.General.Notas"}}</label>
          <textarea name="system.notas" rows="4" class="tq-notas">{{system.notas}}</textarea>
        </div>
      </div>
    </div>

  </div>
</div>
